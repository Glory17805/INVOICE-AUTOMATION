# Claude API key for LLM-based invoice extraction.
# If unset, the app falls back to the built-in heuristic extractor and every
# document is routed to Quick Review instead of being auto-confirmed.
ANTHROPIC_API_KEY=

# Model used for extraction. Leave as-is unless you have a reason to change it.
GST_EXTRACTION_MODEL=claude-opus-5

# Path to the master GST workbook, relative to this backend/ directory.
# The app never writes to this file - it seeds a per-period working copy
# under backend/data/workbook/ on first use.
GST_SOURCE_WORKBOOK=../../01 Ira Innovations May-26 GST Calculation.xlsx

# Who approves what:
#   flagged_only (default) - clean documents go straight to Ready
#   every_row              - every document stops at Quick Review first
# Either way nothing is written to the workbook without someone pressing Post.
GST_APPROVAL_MODE=flagged_only

# --------------------------------------------------------------------------- #
# Access
# --------------------------------------------------------------------------- #

# Shared secret required on every API call, sent as an X-API-Key header.
#
# Empty means the API is OPEN: anything that can reach the port can download
# the GST workbook and read every stored invoice. That is a reasonable default
# while both halves run on your own machine, and the wrong one the moment this
# is reachable from anywhere else. Set it before that happens.
#
# Give the same value to the frontend (frontend/run.ps1 --api-key, or
# GST_API_KEY in the frontend's environment) so the browser can attach it.
#
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
GST_API_KEY=

# Origins the browser may call this API from. Defaults to localhost and
# 127.0.0.1 on the frontend port below. Comma-separated; never use "*" here,
# because that would let any page the user has open call this API.
# GST_FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# The frontend's port, used only to build the default origins above.
GST_FRONTEND_PORT=3000

# Largest single uploaded file accepted, in megabytes.
GST_MAX_UPLOAD_MB=25
