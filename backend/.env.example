# Claude API key for LLM-based invoice extraction.
# If unset, the app falls back to the built-in heuristic extractor and every
# document is routed to Quick Review instead of being auto-confirmed.
ANTHROPIC_API_KEY=

# Model used for extraction. Leave as-is unless you have a reason to change it.
GST_EXTRACTION_MODEL=claude-opus-5

# Path to the master GST workbook, relative to this backend/ directory.
# The app never writes to this file - it seeds a per-period working copy
# under backend/data/workbook/ on first use.
GST_SOURCE_WORKBOOK=../../01 Ira Innovations May-26 GST Calculation.xlsx

# Who approves what:
#   flagged_only (default) - clean documents go straight to Ready
#   every_row              - every document stops at Quick Review first
# Either way nothing is written to the workbook without someone pressing Post.
GST_APPROVAL_MODE=flagged_only

# --------------------------------------------------------------------------- #
# Access
# --------------------------------------------------------------------------- #

# Shared secret required on every API call, sent as an X-API-Key header.
#
# Empty means the API is OPEN: anything that can reach the port can download
# the GST workbook and read every stored invoice. That is a reasonable default
# while both halves run on your own machine, and the wrong one the moment this
# is reachable from anywhere else. Set it before that happens.
#
# Give the same value to the frontend (frontend/run.ps1 --api-key, or
# GST_API_KEY in the frontend's environment) so the browser can attach it.
#
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
GST_API_KEY=

# Origins the browser may call this API from. Defaults to localhost and
# 127.0.0.1 on the frontend port below. Comma-separated; never use "*" here,
# because that would let any page the user has open call this API.
# GST_FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# The frontend's port, used only to build the default origins above.
GST_FRONTEND_PORT=3000

# Largest single uploaded file accepted, in megabytes.
GST_MAX_UPLOAD_MB=25

# ---------------------------------------------------------------------------
# Which LLM reads invoices: "gemini" or "claude".
# Leave GST_EXTRACTION_PROVIDER unset and whichever key is present wins.
#
# Gemini's FREE tier is fine for testing, but Google may use free-tier inputs
# to improve their models - so do not put real client invoices through it.
# Use a paid tier (or Claude) for actual filings.
# ---------------------------------------------------------------------------
GST_EXTRACTION_PROVIDER=gemini

# Paste your Gemini key here. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for extraction. 3.6-flash reads PDFs well and is on the free tier.
GST_GEMINI_MODEL=gemini-3.6-flash

# --------------------------------------------------------------------------- #
# OCR, for scans and photographs
# --------------------------------------------------------------------------- #
# OCR turns itself on as soon as a Tesseract engine is present - there is no
# switch to forget. Install one with:
#     winget install UB-Mannheim.TesseractOCR
# Set this only if it lives somewhere the usual search will not find it.
# GST_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Recognition language. "eng" reads English invoices, which is what GST
# invoices are printed in even where the business speaks something else.
# GST_OCR_LANG=eng

# --------------------------------------------------------------------------- #
# When to call the extraction provider
# --------------------------------------------------------------------------- #
# By default the offline rules read every document first, and the provider is
# called only for the ones the rules are not confident about. Set this to send
# every document to the provider instead - slower, and it spends quota on
# invoices the rules already handle.
# GST_ALWAYS_ASK_PROVIDER=0

# --------------------------------------------------------------------------- #
# Deployment
# --------------------------------------------------------------------------- #
# Where the browser reaches the frontend. Used to build password-reset links,
# which the backend cannot infer: it never serves the page, so the browser's
# address and the API's address are different by design. Wrong here means
# reset links that point at localhost and work for nobody.
# GST_APP_URL=https://gst.example.in

# Where workbooks, the queue database and archived invoices live. Defaults to
# backend/data. On a server this should be a mounted volume that survives a
# redeploy - everything the application cannot rebuild is in here.
#
# NOTE: this one is read from the real environment, not from this file. It has
# to be settable before anything reads the file that would configure it. Export
# it in the service unit or the shell, not here.
# GST_DATA_DIR=/var/lib/ira-gst/data

# Where `python -m app.backup` writes, and how many snapshots to keep.
# Point this somewhere OTHER than the data directory: a backup on the same
# disk as the workbook protects against nothing.
# GST_BACKUP_DIR=/var/backups/ira-gst
# GST_BACKUP_KEEP=14

# Whether the Gemini key is a paid tier. On "free", Google may use what you
# send to improve their models, so the app warns before real invoices go
# through it. Set to "paid" once you are on a paid plan.
# GST_GEMINI_TIER=free

# Alternatives the code also accepts, for environments that already set them:
#   GOOGLE_API_KEY        instead of GEMINI_API_KEY
#   ANTHROPIC_AUTH_TOKEN  instead of ANTHROPIC_API_KEY
