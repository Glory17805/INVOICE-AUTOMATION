# Claude API key for LLM-based invoice extraction.
# If unset, the app falls back to the built-in heuristic extractor and every
# document is routed to Quick Review instead of being auto-confirmed.
ANTHROPIC_API_KEY=

# Model used for extraction. Leave as-is unless you have a reason to change it.
GST_EXTRACTION_MODEL=claude-opus-5

# Path to the master GST workbook, relative to this backend/ directory.
# The app never writes to this file - it seeds a per-period working copy
# under backend/data/workbook/ on first use.
GST_SOURCE_WORKBOOK=../../01 Ira Innovations May-26 GST Calculation.xlsx

# Who approves what:
#   flagged_only (default) - clean documents go straight to Ready
#   every_row              - every document stops at Quick Review first
# Either way nothing is written to the workbook without someone pressing Post.
GST_APPROVAL_MODE=flagged_only
