# Copy to .env for `docker compose up`. Paths are machine-specific, so .env is
# gitignored and this file records the shape rather than the values.

# The master GST workbook the app seeds each period's working copy from. The
# API refuses to start without it, by design.
GST_MASTER_WORKBOOK=/absolute/path/to/01 Ira Innovations May-26 GST Calculation.xlsx

# Optional: exercise the Claude reader instead of the offline one.
# GST_EXTRACTION_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-api03-...
